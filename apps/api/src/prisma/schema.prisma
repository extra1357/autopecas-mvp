generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id                  String     @id @default(uuid())
  nome                String?
  telefone            String     @unique
  endereco            String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  aceitaMarketing     Boolean?
  consentimentoEm     DateTime?
  consentimentoOrigem String?
  veiculoAno          String?
  veiculoModelo       String?
  conversas           Conversa[]
  pedidos             Pedido[]

  @@map("clientes")
}

model Conversa {
  id          String         @id @default(uuid())
  clienteId   String
  estadoAtual EstadoConversa @default(INICIO)
  status      StatusConversa @default(ATIVA)
  contexto    Json           @default("{}")
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  atendimento Atendimento?
  cliente     Cliente        @relation(fields: [clienteId], references: [id])
  logs        LogConversa[]
  mensagens   Mensagem[]
  pedidos     Pedido[]

  @@map("conversas")
}

model Mensagem {
  id         String         @id @default(uuid())
  conversaId String
  origem     OrigemMensagem
  conteudo   String
  metadata   Json?
  timestamp  DateTime       @default(now())
  conversa   Conversa       @relation(fields: [conversaId], references: [id])

  @@map("mensagens")
}

model Produto {
  id          String       @id @default(uuid())
  codigo      String       @unique
  nome        String
  aplicacao   String?
  marca       String?
  estoque     Int          @default(0)
  preco       Decimal      @db.Decimal(10, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  itensPedido ItemPedido[]

  @@map("produtos")
}

model Pedido {
  id          String         @id @default(uuid())
  clienteId   String
  conversaId  String?
  status      StatusPedido   @default(RASCUNHO)
  tipoEntrega TipoEntrega?
  pagamento   TipoPagamento?
  total       Decimal?       @db.Decimal(10, 2)
  endereco    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  itens       ItemPedido[]
  cliente     Cliente        @relation(fields: [clienteId], references: [id])
  conversa    Conversa?      @relation(fields: [conversaId], references: [id])

  @@map("pedidos")
}

model ItemPedido {
  id         String  @id @default(uuid())
  pedidoId   String
  produtoId  String
  quantidade Int
  precoUnit  Decimal @db.Decimal(10, 2)
  pedido     Pedido  @relation(fields: [pedidoId], references: [id])
  produto    Produto @relation(fields: [produtoId], references: [id])

  @@map("itens_pedido")
}

model Atendimento {
  id          String                @id @default(uuid())
  conversaId  String                @unique
  vendedorId  String?
  status      StatusAtendimento     @default(PENDENTE)
  prioridade  PrioridadeAtendimento @default(MEDIA)
  resumo      String?
  slaMinutos  Int                   @default(30)
  iniciadoEm  DateTime?
  resolvidoEm DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  conversa    Conversa              @relation(fields: [conversaId], references: [id])

  @@map("atendimentos")
}

model LogConversa {
  id         String   @id @default(uuid())
  conversaId String
  tipo       String
  payload    Json
  createdAt  DateTime @default(now())
  conversa   Conversa @relation(fields: [conversaId], references: [id])

  @@map("logs_conversa")
}

model PerguntaSemResposta {
  id         String   @id @default(uuid())
  pergunta   String
  conversaId String?
  resolvida  Boolean  @default(false)
  criadoEm   DateTime @default(now())

  @@map("perguntas_sem_resposta")
}

model BaseConhecimento {
  id         String                 @id @default(uuid())
  titulo     String
  conteudo   String
  tags       String[]
  relevancia Int                    @default(1)
  criadoEm   DateTime               @default(now())
  embedding  Unsupported("vector")?

  @@map("base_conhecimento")
}

enum StatusConversa {
  ATIVA
  AGUARDANDO_HUMANO
  EM_ATENDIMENTO
  FINALIZADA
  EXPIRADA
}

enum EstadoConversa {
  INICIO
  AGUARDANDO_PECA
  AGUARDANDO_VEICULO
  CONSULTANDO_ESTOQUE
  AGUARDANDO_ENDERECO
  AGUARDANDO_PAGAMENTO
  AGUARDANDO_VENDEDOR
  FINALIZADO
  AGUARDANDO_TIPO_ATENDIMENTO
  AGUARDANDO_HUMANO
  FINALIZADA
  AGUARDANDO_CONFIRMACAO_KIT
  AGUARDANDO_CONFIRMACAO_ITEM
  AGUARDANDO_MAIS_ITENS
}

enum OrigemMensagem {
  CLIENTE
  IA
  HUMANO
  SISTEMA
}

enum StatusPedido {
  RASCUNHO
  AGUARDANDO_PAGAMENTO
  PAGO
  SEPARANDO
  ENVIADO
  ENTREGUE
  CANCELADO
}

enum TipoEntrega {
  DELIVERY
  RETIRADA
}

enum TipoPagamento {
  PIX
  CARTAO
  DINHEIRO
  BOLETO
}

enum StatusAtendimento {
  PENDENTE
  EM_ANDAMENTO
  RESOLVIDO
  EXPIRADO
}

enum PrioridadeAtendimento {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}
